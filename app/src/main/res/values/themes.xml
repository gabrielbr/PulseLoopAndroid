<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark-only: the window starts on PulseColors.background so a cold start
         doesn't flash white before Compose draws its first frame. -->
    <color name="window_background">#121214</color>
    <style name="Theme.PulseLoop" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
